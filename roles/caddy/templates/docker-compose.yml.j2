# {{ ansible_managed }}
services:
  caddy:
    image: {{ caddy_image }}
    container_name: caddy
    restart: unless-stopped
    # сеть хоста: caddy слушает :80 и {{ caddy_bind_address }}:{{ caddy_port }}, ходит в панель на 127.0.0.1
    network_mode: host
    volumes:
      - ./conf:/etc/caddy:ro
      - ./site:/srv:ro
      - ./data:/data
      - ./config:/config
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
